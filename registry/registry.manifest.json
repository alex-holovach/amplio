    {
      "name": "plugin-next",
      "title": "Next.js Plugin",
      "kind": "plugin",
      "role": "boundary",
      "recipeVersion": "1.0.0",
      "nativeTransform": { "version": 1 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "next": ">=15 <17" },
      "testedProviderVersions": {
        "next": { "minimum": "15.0.0", "latest": "16.3.1" }
      },
      "description": "Next.js route-handler boundary Plugin preserving Response identity.",
      "source": "plugins/next.ts",
      "target": "telemetry/plugins/next.ts",
      "dependencies": ["next@^15.2.4", "@useamplio/amplio"],
      "registryDependencies": ["event-http-request", "runtime"],
      "events": [{ "id": "http.request", "version": 1 }],
      "wiringActions": [
        {
          "type": "wrap-boundary",
          "export": "withAmplio",
          "description": "Wrap a route handler and optionally supply a stable semantic route."
        }
      ],
      "privacy": {
        "includes": ["request_id", "http.method", "http.route", "http.status"],
        "excludes": ["url", "path", "query", "headers", "cookies", "body"]
      }
    },
    {
      "name": "plugin-trpc",
      "title": "tRPC Plugin",
      "kind": "plugin",
      "role": "contributor",
      "recipeVersion": "1.0.0",
      "nativeTransform": { "version": 1 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "@trpc/server": ">=11 <12" },
      "testedProviderVersions": {
        "@trpc/server": { "minimum": "11.0.0", "latest": "11.18.0" }
      },
      "description": "tRPC contributor Plugin recording nested query and mutation duration Events while leaving subscriptions unchanged.",
      "source": "plugins/trpc.ts",
      "target": "telemetry/plugins/trpc.ts",
      "dependencies": ["zod", "@useamplio/amplio", "@trpc/server@^11.0.0"],
      "events": [{ "id": "trpc.procedure", "version": 1 }],
      "placement": { "branch": "rpc" },
      "provider": {
        "package": "@trpc/server",
        "instrumenter": "TrpcPlugin",
        "seam": "trpc-middleware",
        "initializer": "initTRPC"
      },
      "wiringActions": [
        {
          "type": "mount-event-subtree",
          "description": "Mount TrpcPlugin.events under the rpc branch."
        },
        {
          "type": "register-contributor",
          "export": "TrpcPlugin",
          "description": "Register with the application's ordinary tRPC middleware builder."
        }
      ],
      "privacy": {
        "includes": ["path", "type", "duration_ms", "success"],
        "excludes": [
          "input",
          "output",
          "context",
          "headers",
          "auth",
          "session",
          "tokens",
          "error message",
          "stack"
        ]
      }
    },
    {
      "name": "plugin-better-auth",
      "title": "Better Auth Plugin",
      "kind": "plugin",
      "role": "contributor",
      "recipeVersion": "1.0.0",
      "nativeTransform": { "version": 1 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "better-auth": ">=1.2.1 <2" },
      "testedProviderVersions": {
        "better-auth": { "minimum": "1.2.1", "latest": "1.6.29" }
      },
      "description": "Better Auth contributor Plugin using native after hooks for privacy-safe sign-in and sign-up semantics.",
      "source": "plugins/better-auth.ts",
      "target": "telemetry/plugins/better-auth.ts",
      "dependencies": ["zod", "@useamplio/amplio", "better-auth@^1.2.1"],
      "events": [
        { "id": "auth.signed_in", "version": 1 },
        { "id": "auth.signed_up", "version": 1 }
      ],
      "placement": { "branch": "auth" },
      "provider": {
        "package": "better-auth",
        "instrumenter": "BetterAuthPlugin",
        "seam": "better-auth-plugin",
        "factory": "betterAuth"
      },
      "wiringActions": [
        {
          "type": "mount-event-subtree",
          "description": "Mount BetterAuthPlugin.events under the auth branch."
        },
        {
          "type": "register-native-plugin",
          "export": "BetterAuthPlugin",
          "description": "Append BetterAuthPlugin() to one unambiguous betterAuth plugins array."
        }
      ],
      "privacy": {
        "includes": ["method", "user.id", "mfa"],
        "excludes": [
          "email",
          "session id",
          "tokens",
          "headers",
          "body",
          "callback url"
        ]
      }
    },
    {
      "name": "plugin-ai-sdk",
      "title": "AI SDK Plugin",
      "kind": "plugin",
      "role": "contributor",
      "recipeVersion": "1.1.0",
      "nativeTransform": { "version": 2 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "ai": ">=7 <8" },
      "testedProviderVersions": {
        "ai": { "minimum": "7.0.0", "latest": "7.0.65" }
      },
      "description": "AI SDK contributor Plugin using native telemetry for promise operations and an exact-result streamText wrapper for streamed completion.",
      "source": "plugins/ai-sdk.ts",
      "target": "telemetry/plugins/ai-sdk.ts",
      "dependencies": ["zod", "@useamplio/amplio", "ai@^7.0.0"],
      "events": [{ "id": "ai.operation", "version": 2 }],
      "placement": { "branch": "ai" },
      "provider": {
        "package": "ai",
        "instrumenter": "AiSdkPlugin",
        "seam": "telemetry-registration",
        "registrar": "registerTelemetry"
      },
      "wiringActions": [
        {
          "type": "mount-event-subtree",
          "description": "Mount AiSdkPlugin.events under the ai branch."
        },
        {
          "type": "register-telemetry",
          "export": "AiSdkPlugin",
          "description": "Register AiSdkPlugin() once through AI SDK's native registerTelemetry startup seam."
        }
      ],
      "privacy": {
        "includes": [
          "operation",
          "normalized provider category",
          "normalized model family",
          "bounded generation settings",
          "finish_reason",
          "token counts",
          "aggregate item, step, tool, and result counts",
          "bounded timeout and performance durations",
          "duration_ms",
          "success"
        ],
        "excludes": [
          "call ids",
          "function ids",
          "raw provider ids",
          "raw model ids",
          "raw seeds",
          "prompts",
          "system prompts",
          "messages",
          "generated content",
          "reasoning text",
          "tool names",
          "tool arguments",
          "tool results",
          "embedding values",
          "documents",
          "queries",
          "headers",
          "provider options",
          "provider metadata",
          "request bodies",
          "response bodies",
          "raw errors"
        ]
      }
    },
    {
      "name": "plugin-resend",
      "title": "Resend Plugin",
      "kind": "plugin",
      "role": "contributor",
      "recipeVersion": "1.0.0",
      "nativeTransform": { "version": 1 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "resend": ">=4 <5" },
      "testedProviderVersions": {
        "resend": { "minimum": "4.0.0", "latest": "4.8.0" }
      },
      "description": "Resend contributor Plugin with privacy-safe email send observations.",
      "source": "plugins/resend.ts",
      "target": "telemetry/plugins/resend.ts",
      "dependencies": ["zod", "@useamplio/amplio", "resend@^4.0.0"],
      "events": [{ "id": "resend.send", "version": 1 }],
      "placement": { "branch": "email" },
      "provider": {
        "package": "resend",
        "constructor": "Resend",
        "instrumenter": "ResendPlugin",
        "seam": "constructor"
      },
      "wiringActions": [
        {
          "type": "wrap-constructor",
          "description": "Wrap one unambiguous new Resend(...) composition root."
        },
        {
          "type": "mount-event-subtree",
          "description": "Mount ResendPlugin.events under the email branch."
        }
      ],
      "privacy": {
        "includes": ["provider", "template"],
        "excludes": [
          "to",
          "cc",
          "bcc",
          "from",
          "subject",
          "html",
          "text",
          "react",
          "key"
        ]
      }
    },
    {
      "name": "runtime",
      "kind": "runtime",
      "recipeVersion": "1.0.0",
      "description": "Init-only Amplio runtime configuration.",
      "source": "runtime.ts",
      "target": "telemetry/runtime.ts",
      "dependencies": ["@useamplio/amplio"],
      "registryDependencies": ["sink-console"]
    },
    {
      "name": "sink-console",
      "kind": "sink",
      "recipeVersion": "1.0.0",
