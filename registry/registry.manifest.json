      "source": "sinks/json.ts",
      "target": "telemetry/sinks/json.ts",
      "dependencies": ["@useamplio/amplio"]
    },
    {
      "name": "sink-otlp",
      "kind": "sink",
      "recipeVersion": "1.0.0",
      "description": "OTLP sink that exports Event records over OpenTelemetry.",
      "source": "sinks/otlp.ts",
      "target": "telemetry/sinks/otlp.ts",
      "dependencies": ["@useamplio/amplio"]
    },
    {
      "name": "enricher-service-metadata",
      "kind": "enricher",
      "recipeVersion": "1.0.0",
      "description": "Resource enricher for bounded deployment name, version, and region attributes.",
      "source": "enrichers/service-metadata.ts",
      "target": "telemetry/enrichers/service-metadata.ts",
      "dependencies": ["@useamplio/amplio"],
      "privacy": {
        "includes": [
          "deployment.name",
          "deployment.version",
          "deployment.region"
        ],
        "excludes": ["event fields", "request data", "payload data"]
      }
    }
  ]
}
