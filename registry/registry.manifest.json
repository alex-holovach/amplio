{
  "name": "amplio",
  "homepage": "https://github.com/alex-holovach/amplio",
  "items": [
    {
      "name": "event-http-request",
      "title": "HTTP Request Event",
      "kind": "event",
      "recipeVersion": "1.0.0",
      "description": "Root HTTP request Event for framework boundary Plugins.",
      "source": "events/http-request.ts",
      "target": "telemetry/events/http-request.ts",
      "dependencies": ["zod", "@useamplio/amplio"],
      "events": [{ "id": "http.request", "version": 1 }],
      "privacy": {
        "includes": ["request_id", "http.method", "http.route", "http.status"],
        "excludes": ["url", "path", "query", "headers", "cookies", "body"]
      }
    },
    {
      "name": "plugin-hono",
      "title": "Hono Plugin",
      "kind": "plugin",
      "role": "boundary",
      "recipeVersion": "1.0.0",
      "nativeTransform": { "version": 1 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "hono": ">=4 <5" },
      "testedProviderVersions": {
        "hono": { "minimum": "4.0.0", "latest": "4.13.2" }
      },
      "description": "Hono boundary Plugin that closes one HTTP Event per request.",
      "source": "plugins/hono.ts",
      "target": "telemetry/plugins/hono.ts",
      "dependencies": ["hono@^4.7.4", "@useamplio/amplio"],
      "registryDependencies": ["event-http-request", "runtime"],
      "events": [{ "id": "http.request", "version": 1 }],
      "wiringActions": [
        {
          "type": "register-boundary",
          "export": "HonoPlugin",
          "description": "Register before Hono routes with app.use."
        }
      ],
      "privacy": {
        "includes": ["request_id", "http.method", "http.route", "http.status"],
        "excludes": ["url", "path", "query", "headers", "cookies", "body"]
      }
    },
    {
      "name": "plugin-express",
      "title": "Express Plugin",
      "kind": "plugin",
      "role": "boundary",
      "recipeVersion": "1.0.0",
      "nativeTransform": { "version": 1 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "express": ">=4 <6" },
      "testedProviderVersions": {
        "express": { "minimum": "4.0.0", "latest": "5.2.1" }
      },
      "description": "Express boundary Plugin spanning callbacks through the final response.",
      "source": "plugins/express.ts",
      "target": "telemetry/plugins/express.ts",
      "dependencies": ["express@^4.21.2", "@useamplio/amplio"],
      "devDependencies": ["@types/express@^5.0.0"],
      "registryDependencies": ["event-http-request", "runtime"],
      "events": [{ "id": "http.request", "version": 1 }],
      "wiringActions": [
        {
          "type": "register-boundary",
          "export": "withAmplioRoute",
          "description": "Spread the returned route layers before ordinary Express handlers."
        }
      ],
      "privacy": {
        "includes": ["request_id", "http.method", "http.route", "http.status"],
        "excludes": ["url", "path", "query", "headers", "cookies", "body"]
      }
    },
    {
      "name": "plugin-fastify",
      "title": "Fastify Plugin",
      "kind": "plugin",
      "role": "boundary",
      "recipeVersion": "1.0.0",
      "nativeTransform": { "version": 1 },
      "coreRange": ">=0.1.0-alpha.17 <1",
      "providerRanges": { "fastify": ">=5 <6" },
      "testedProviderVersions": {
        "fastify": { "minimum": "5.0.0", "latest": "5.12.0" }
      },
      "description": "Fastify boundary Plugin spanning request hooks through final onResponse status.",
      "source": "plugins/fastify.ts",
      "target": "telemetry/plugins/fastify.ts",
      "dependencies": ["fastify@^5.2.1", "@useamplio/amplio"],
      "registryDependencies": ["event-http-request", "runtime"],
      "events": [{ "id": "http.request", "version": 1 }],
      "wiringActions": [
        {
          "type": "register-boundary",
          "export": "FastifyPlugin",
          "description": "Register once before ordinary Fastify routes."
        }
      ],
      "privacy": {
        "includes": ["request_id", "http.method", "http.route", "http.status"],
