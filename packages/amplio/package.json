{
  "name": "@useamplio/amplio",
  "version": "0.1.0-alpha.17",
  "description": "Composable semantic runtime for open-code wide events",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-holovach/amplio.git",
    "directory": "packages/amplio"
  },
  "homepage": "https://github.com/alex-holovach/amplio#readme",
  "bugs": {
    "url": "https://github.com/alex-holovach/amplio/issues"
  },
  "keywords": [
    "telemetry",
    "observability",
    "wide-events",
    "logging",
    "composable-semantics",
    "structured-logging"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "build": "tsup && node scripts/annotate-dynamic-import.mjs && node ../../scripts/copy-docs.mjs .",
    "pretest": "node ../../scripts/copy-docs.mjs .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=20"
  }
}
