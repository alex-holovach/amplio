{
  "name": "@useamplio/cli",
  "version": "0.1.0-alpha.16",
  "description": "Scaffold open-code Event and Plugin telemetry",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
