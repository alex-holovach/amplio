    "@useamplio/amplio": "workspace:*",
    "better-auth": "^1.2.0",
    "express": "^4.21.2",
    "fastify": "^5.2.1",
    "hono": "^4.7.4",
    "next": "^15.2.4",
    "prettier": "3",
