{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "typeRoots": ["../../node_modules/@types"],
    "baseUrl": "../..",
    "paths": {
      "@useamplio/amplio": ["../amplio/dist/index.d.ts"],
      "@useamplio/amplio/plugin": ["../amplio/dist/plugin.d.ts"],
      "hono": ["node_modules/hono"],
      "fastify": ["node_modules/fastify"],
      "next/server": ["node_modules/next/server.d.ts"],
      "next/*": ["node_modules/next/*"],
      "@trpc/server": ["node_modules/@trpc/server"],
      "@trpc/server/*": ["node_modules/@trpc/server/*"],
      "better-auth": ["node_modules/better-auth"],
      "better-auth/api": ["node_modules/better-auth/dist/api/index.d.mts"],
      "better-auth/*": ["node_modules/better-auth/*"],
      "@clerk/backend/*": ["node_modules/@clerk/backend/*"],
      "resend": ["node_modules/resend"],
      "@polar-sh/sdk": ["node_modules/@polar-sh/sdk"],
      "zod": ["node_modules/zod"]
    }
  },
  "include": [
    "../../../../registry/sinks/**/*.ts",
    "../../../../registry/enrichers/**/*.ts",
    "../../../../registry/events/**/*.ts",
    "../../../../registry/plugins/hono.ts",
    "../../../../registry/plugins/express.ts",
    "../../../../registry/plugins/fastify.ts",
    "../../../../registry/plugins/next.ts",
    "../../../../registry/plugins/trpc.ts",
    "../../../../registry/plugins/better-auth.ts",
    "../../../../registry/plugins/resend.ts",
    "../../../../registry/runtime.ts",
    "ambient-express.d.ts",
    "next-explicit-route.ts"
  ]
}
